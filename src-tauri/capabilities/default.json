{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ReleaseHub local workspace and native window controls.",
  "windows": ["main"],
  "permissions": [
    "core:default", "allow-host-dispatch",
    "core:window:allow-minimize", "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized", "core:window:allow-close",
    "core:window:allow-start-dragging", "core:window:allow-set-theme"
  ]
}
