{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReleaseHub",
  "version": "0.6.1",
  "identifier": "io.github.huai-bot.releasehub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "ReleaseHub · 追新", "width": 1280, "height": 840, "minWidth": 960, "minHeight": 640, "center": true, "decorations": false, "shadow": true, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://avatars.githubusercontent.com data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "轻量、便携的 GitHub 发行资源管理器",
    "longDescription": "集中订阅 GitHub 软件与文件，管理发行附件、Stars 分类与项目备注，查看首页动态，通过 MCP 向外部 AI 提供软件资料。",
    "resources": {
      "tools/": "tools/",
      "../docs/AGENT_GUIDE.md": "integrations/AGENT_GUIDE.md",
      "../integrations/releasehub-agent.ps1": "integrations/releasehub-agent.ps1"
    },
    "copyright": "Copyright © 2026 huai-bot",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false },
      "nsis": { "displayLanguageSelector": true, "languages": ["SimpChinese", "English"], "installMode": "currentUser", "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico" }
    }
  }
}
